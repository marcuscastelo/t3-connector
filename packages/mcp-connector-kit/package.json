{
  "name": "mcp-connector-kit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Shared layer for building MCP connectors: tool plumbing (strict schemas, results, errors) and the OAuth session profile (authorization server, MCP resource server over Streamable HTTP, sessions with idle/max age, refresh, passkeys, control plane, audit). No T3 or Fleet knowledge.",
  "license": "MIT",
  "exports": {
    ".": "./index.mjs",
    "./oauth": "./oauth/index.mjs",
    "./oauth/*": "./oauth/*.mjs",
    "./testing": "./testing/index.mjs"
  },
  "files": [
    "index.mjs",
    "oauth/",
    "testing/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "qrcode": "1.5.4",
    "zod": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcuscastelo/t3-connector.git",
    "directory": "packages/mcp-connector-kit"
  }
}
